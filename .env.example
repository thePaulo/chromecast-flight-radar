# Your home location (latitude and longitude)
# Tip: Right-click your home on Google Maps to copy exact coordinates
LAT=43.6532
LON=-79.3832

# Search radius in nautical miles (15-30 nm is a great starting point)
RADIUS_NM=25

# Display units: imperial (mi, ft, kts/mph) or metric (km, m, km/h)
UNITS=imperial

# Set to true to only show commercial flights (hide private planes/helicopters)
COMMERCIAL_ONLY=false

# Polling interval in seconds (10 is recommended)
POLL_SECONDS=10

# Local server port
PORT=8080

# Your Chromecast Ultra target
CHROMECAST_NAME=Mini Monitor
CHROMECAST_HOST=192.168.2.18

# Optional: Set your deployed Cloudflare Worker URL here for PC-independent casting
# Example: PUBLIC_URL=https://flightwall.your-subdomain.workers.dev
PUBLIC_URL=
